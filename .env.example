# Copy to apps/web/.env.local (git-ignored). NEVER put secrets in NEXT_PUBLIC_* vars.
# Values come from the dev stack outputs: `pnpm --filter infra cdk deploy` prints them.
NEXT_PUBLIC_API_URL=https://<api-id>.execute-api.ap-south-1.amazonaws.com
NEXT_PUBLIC_CDN_URL=
NEXT_PUBLIC_CUSTOMER_POOL_ID=
NEXT_PUBLIC_CUSTOMER_POOL_CLIENT_ID=
NEXT_PUBLIC_ADMIN_POOL_ID=
NEXT_PUBLIC_ADMIN_POOL_CLIENT_ID=
NEXT_PUBLIC_ENV_NAME=dev
